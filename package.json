    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "eslint": "9.38.0",
    "eslint-config-next": "16.2.11",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=20.9 <25"
  }
}
